# ── LLM keys (at least one is required) ─────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=            # optional (Azure/proxy)

GLM_API_KEY=
GLM_MODEL=glm-4.6
# International Z.ai:  https://api.z.ai/api/paas/v4/
# China BigModel:      https://open.bigmodel.cn/api/paas/v4/
GLM_BASE_URL=https://api.z.ai/api/paas/v4/

# ── GitHub (fine-grained or classic token with repo access) ─────
GITHUB_TOKEN=

# ── Which model each agent uses: openai | glm ───────────────────
ORCHESTRATOR_PROVIDER=openai
RESEARCHER_PROVIDER=openai
CODER_PROVIDER=glm
GITHUB_AGENT_PROVIDER=openai
OPERATOR_PROVIDER=glm

# ── Safety ──────────────────────────────────────────────────────
# true = every shell command / app launch / outside-workspace write waits for your Approve click
REQUIRE_APPROVAL=true
MAX_ORCHESTRATOR_STEPS=8
# WORKSPACE_DIR=./workspace
